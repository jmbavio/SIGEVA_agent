# Plantilla de los "Secrets" para Streamlit Community Cloud. NO es el
# archivo real (ese es .streamlit/secrets.toml, gitignoreado — nunca se
# versiona). En Cloud, estos mismos valores se cargan desde el dashboard:
# tu app > Settings > Secrets, pegando el contenido con tus valores reales.
#
# Para correr localmente con `streamlit run app.py` podés copiar este
# archivo a .streamlit/secrets.toml y completarlo, o simplemente usar un
# .env (ver .env.example) — app.py lee cualquiera de los dos.

LLM_PROVIDER = "openai"
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o-mini"

GOOGLE_API_KEY = ""
GEMINI_MODEL = "gemini-1.5-flash"

# Si lo configurás, el checkbox del resolutor LLM en la UI pide este
# passcode antes de habilitarse — pensado para cuando la app queda
# pública en Cloud, así no cualquiera con el link te consume la API key.
# Dejalo vacío/sin definir para que el checkbox quede libre (uso local).
APP_PASSCODE = ""
