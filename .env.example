# Proveedor de LLM a usar para el resolutor semántico (ver
# src/matching/llm_semantic.py y src/matching/llm_provider.py).
# Valores: openai | gemini
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Para correr main.py contra tus propios PDFs de SIGEVA en vez del demo
# JSON. Las rutas son locales a tu máquina — nunca se versionan (ver
# .gitignore). Instancias válidas: UNS, CONICET, CIC, CVAR.
SIGEVA_RUTA_A=
SIGEVA_INSTANCIA_A=UNS
SIGEVA_RUTA_B=
SIGEVA_INSTANCIA_B=CONICET
